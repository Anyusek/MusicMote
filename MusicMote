def get_system_language() -> str:
    try:
        import locale
        loc = locale.getdefaultlocale()[0]
        if loc and loc.lower().startswith("ru"):
            return "ru"
    except Exception:
        pass
    return "en"

def get_system_theme() -> str:
    try:
        import winreg
        key = winreg.OpenKey(
            winreg.HKEY_CURRENT_USER,
            r"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"
        )
        val, _ = winreg.QueryValueEx(key, "AppsUseLightTheme")
        winreg.CloseKey(key)
        return "light" if val == 1 else "dark"
    except Exception:
        pass
    return "dark"

def resolve_language(lang: str) -> str:
    if lang == "system":
        return get_system_language()
    return lang if lang in ("ru", "en") else "ru"

def resolve_theme(theme: str) -> str:
    if theme == "system":
        return get_system_theme()
    return theme if theme in ("dark", "light") else "dark"

def load_config() -> dict:
    default_config = {
        "app_path": "",
        "language": "ru",
        "theme": "dark",
        "hotkeys": DEFAULT_HOTKEYS.copy()
    }
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                default_config.update(data)
        except Exception as e:
            logger.error("Error reading config: %s", e)
    return default_config

def save_config(config_data: dict):
    try:
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(config_data, f, ensure_ascii=False, indent=4)
    except Exception as e:
        logger.error("Error saving config: %s", e)

def validate_path(path_obj: Path) -> bool:
    if not path_obj or not path_obj.exists() or not path_obj.is_file():
        return False
    name_lower = path_obj.name.lower()
    return "яндекс музыка" in name_lower or "yandexmusic" in name_lower or "yandex music" in name_lower

def resolve_shortcut(lnk_path: Path) -> Optional[Path]:
    if not HAS_WIN32COM or lnk_path.suffix.lower() != '.lnk':
        return None
    try:
        shell = win32com.client.Dispatch("WScript.Shell")
        shortcut = shell.CreateShortCut(str(lnk_path))
        target = Path(shortcut.Targetpath)
        if target.exists():
            return target
    except Exception as e:
        logger.error("Ошибка чтения ярлыка: %s", e)
    return None

def auto_find_app() -> Optional[Path]:
    local_app_data = os.environ.get("LOCALAPPDATA", "")
    program_files = os.environ.get("PROGRAMFILES", "C:\\Program Files")
    program_files_x86 = os.environ.get("PROGRAMFILES(X86)", "C:\\Program Files (x86)")
    
    search_paths = [
        Path(local_app_data) / "Programs" / "YandexMusic" / "Яндекс Музыка.exe",
        Path(local_app_data) / "Programs" / "YandexMusic" / "YandexMusic.exe",
        Path(program_files) / "YandexMusic" / "Яндекс Музыка.exe",
        Path(program_files_x86) / "YandexMusic" / "Яндекс Музыка.exe",
    ]
    for p in search_paths:
        if validate_path(p):
            return p
    return None

class YandexMusicWindow:
    def __init__(self):
        self._cached_hwnd: Optional[int] = None

    def _is_valid_target_window(self, hwnd: int) -> bool:
        if not win32gui.IsWindow(hwnd) or not win32gui.IsWindowVisible(hwnd):
            return False
        if win32gui.GetWindow(hwnd, win32con.GW_OWNER) != 0:
            return False
        return WINDOW_TITLE_KEYWORD.lower() in win32gui.GetWindowText(hwnd).lower()

    def find_hwnd(self) -> Optional[int]:
        if self._cached_hwnd and self._is_valid_target_window(self._cached_hwnd):
            return self._cached_hwnd
        found_hwnds: List[int] = []
        def _enum_cb(hwnd: int, _) -> bool:
            if self._is_valid_target_window(hwnd):
                found_hwnds.append(hwnd)
            return True
        win32gui.EnumWindows(_enum_cb, None)
        if found_hwnds:
            self._cached_hwnd = found_hwnds[0]
            return self._cached_hwnd
        self._cached_hwnd = None
        return None

    def send_command(self, command: int) -> bool:
        hwnd = self.find_hwnd()
        if hwnd is None:
            return False
        try:
            win32api.PostMessage(hwnd, WM_APPCOMMAND, hwnd, command << 16)
            return True
        except Exception:
            self._cached_hwnd = None
            return False

    def is_running(self) -> bool:
        return self.find_hwnd() is not None

    def bring_to_front(self) -> bool:
        hwnd = self.find_hwnd()
        if not hwnd: 
            return False
        try:
            if win32gui.IsIconic(hwnd):
                win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
            win32gui.SetForegroundWindow(hwnd)
            return True
        except Exception:
            return False

class MusicService:
    def __init__(self, config: dict):
        self._window = YandexMusicWindow()
        saved_path = config.get("app_path", "")
        self.app_path = Path(saved_path) if saved_path and validate_path(Path(saved_path)) else auto_find_app()

    def launch(self, callback: Optional[Callable[[bool, str], None]] = None) -> None:
        def _worker():
            try:
                if self._window.is_running():
                    self.bring_to_front()
                    if callback: callback(True, "already_running")
                    return
                if not self.app_path or not validate_path(self.app_path):
                    if callback: callback(False, "invalid_path")
                    return
                subprocess.Popen(str(self.app_path))
                start_time = time.time()
                while time.time() - start_time < LAUNCH_TIMEOUT_SEC:
                    if self._window.is_running():
                        if callback: callback(True, "launched_ok")
                        return
                    time.sleep(LAUNCH_POLL_INTERVAL)
                if callback: callback(False, "timeout")
            except Exception as exc:
                if callback: callback(False, str(exc))
        threading.Thread(target=_worker, daemon=True).start()

    def bring_to_front(self) -> bool: return self._window.bring_to_front()
    def play_pause(self) -> bool: return self._window.send_command(APPCOMMAND_MEDIA_PLAY_PAUSE)
    def next_track(self) -> bool: return self._window.send_command(APPCOMMAND_MEDIA_NEXTTRACK)
    def prev_track(self) -> bool: return self._window.send_command(APPCOMMAND_MEDIA_PREVIOUSTRACK)
    def volume_up(self) -> bool: return self._window.send_command(APPCOMMAND_VOLUME_UP)
    def volume_down(self) -> bool: return self._window.send_command(APPCOMMAND_VOLUME_DOWN)
    def volume_mute(self) -> bool: return self._window.send_command(APPCOMMAND_VOLUME_MUTE)

class HotkeysSettingsWindow(ctk.CTkToplevel):
    def __init__(self, parent, config: dict, on_save_cb: Callable[[dict], None]):
        super().__init__(parent)
        self.parent = parent
        self.config = config
        self.on_save_cb = on_save_cb
        
        # Local pending state (applied only on save)
        self.pending_hotkeys = dict(config.get("hotkeys", DEFAULT_HOTKEYS))
        self.pending_lang = config.get("language", "system")
        self.pending_theme = config.get("theme", "system")
        
        effective_lang = resolve_language(self.pending_lang)
        effective_theme = resolve_theme(self.pending_theme)
        
        self.t = TRANSLATIONS[effective_lang]
        self.theme = THEMES[effective_theme]
        
        self._setup_window()
        self._build_ui()

    def _setup_window(self):
        self.title(self.t["settings_title"])
        self.geometry("380x600")
        self.resizable(False, False)
        self.configure(fg_color=self.theme["bg"])
        self.attributes("-topmost", True)
        try:
            ico_path = Path(__file__).parent / "musicmote_icon.ico"
            if ico_path.exists():
                self.iconbitmap(str(ico_path))
        except Exception:
            pass

    def _build_ui(self):
        for widget in self.winfo_children():
            widget.destroy()
            
        effective_lang = resolve_language(self.pending_lang)
        effective_theme = resolve_theme(self.pending_theme)
        self.t = TRANSLATIONS[effective_lang]
        self.theme = THEMES[effective_theme]
        
        t = self.t
        theme = self.theme

        # Header
        ctk.CTkLabel(
            self, text=t["hotkeys_header"], 
            font=("Segoe UI", 18, "bold"), 
            text_color=theme["text"]
        ).pack(pady=(22, 14))

        # Hotkeys List
        items = [
            ("play_pause", t["play_pause"]),
            ("next_track", t["next_track"]),
            ("prev_track", t["prev_track"]),
            ("vol_up", t["vol_up"]),
            ("vol_down", t["vol_down"]),
            ("mute", t["mute"]),
        ]

        self.key_buttons = {}
        for key_id, label_text in items:
            row = ctk.CTkFrame(self, fg_color="transparent")
            row.pack(fill="x", padx=26, pady=4)

            lbl = ctk.CTkLabel(row, text=label_text, font=("Segoe UI", 13), text_color=theme["text"], anchor="w")
            lbl.pack(side="left")

            val = self.pending_hotkeys.get(key_id, DEFAULT_HOTKEYS.get(key_id, ""))
            btn = ctk.CTkButton(
                row, text=val, width=120, height=32,
                corner_radius=8, font=("Segoe UI", 12),
                fg_color=theme["btn_bg"], hover_color=theme["btn_hover"],
                text_color=theme["text"],
                command=lambda k=key_id: self._record_hotkey(k)
            )
            btn.pack(side="right")
            self.key_buttons[key_id] = btn

        # Section: "Прочее" / "Other"
        ctk.CTkLabel(
            self, text=t["other_header"],
            font=("Segoe UI", 16, "bold"),
            text_color=theme["text"]
        ).pack(pady=(16, 8))

        # 🌐 Язык интерфейса
        lang_frame = ctk.CTkFrame(self, fg_color="transparent")
        lang_frame.pack(fill="x", padx=26, pady=6)
        
        ctk.CTkLabel(
            lang_frame, text=f"🌐 {t['interface_lang']}",
            font=("Segoe UI", 13), text_color=theme["text"], anchor="w"
        ).pack(side="left")

        lang_values = [t["lang_system"], t["lang_ru"], t["lang_en"]]
        if self.pending_lang == "system":
            initial_lang_text = t["lang_system"]
        elif self.pending_lang == "ru":
