def create_app_icon_image(size: int = 64):
    """Генерирует фирменную иконку MusicMote (жёлтый скругленный квадрат с глиф-эффектом 'M')."""
    try:
        from PIL import Image, ImageDraw
        img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        radius = int(size * 0.24)
        draw.rounded_rectangle([1, 1, size - 2, size - 2], radius=radius, fill=(255, 186, 0, 255))
        
        scale = size / 100.0
        base_coords = [
            (24.5, 73.0),
            (24.5, 27.0),
            (36.0, 27.0),
            (50.0, 52.5),
            (64.0, 27.0),
            (75.5, 27.0),
            (75.5, 73.0),
            (64.5, 73.0),
            (64.5, 41.5),
            (53.5, 61.5),
            (46.5, 61.5),
            (35.5, 41.5),
            (35.5, 73.0),
        ]
        
        # Левый слой (красно-оранжевый глитч)
        red_poly = [((x - 3.2) * scale, y * scale) for x, y in base_coords]
        draw.polygon(red_poly, fill=(211, 47, 47, 230))
        
        # Правый слой (темно-зеленый глитч)
        green_poly = [((x + 3.2) * scale, y * scale) for x, y in base_coords]
        draw.polygon(green_poly, fill=(27, 94, 32, 230))
        
        # Основной черный слой M
        black_poly = [(x * scale, y * scale) for x, y in base_coords]
        draw.polygon(black_poly, fill=(0, 0, 0, 255))
        
        return img
    except Exception as e:
        logger.debug("Icon creation error: %s", e)
        return None

