        else:
            initial_lang_text = t["lang_en"]

        self.lang_dropdown = ctk.CTkOptionMenu(
            lang_frame, values=lang_values,
            width=140, height=32, corner_radius=8,
            font=("Segoe UI", 12),
            fg_color=theme["btn_bg"], button_color=theme["btn_hover"],
            button_hover_color="#444444", text_color=theme["text"],
            command=self._on_lang_select
        )
        self.lang_dropdown.set(initial_lang_text)
        self.lang_dropdown.pack(side="right")

        # 🎨 Тема интерфейса
        theme_frame = ctk.CTkFrame(self, fg_color="transparent")
        theme_frame.pack(fill="x", padx=26, pady=6)

        ctk.CTkLabel(
            theme_frame, text=f"🎨 {t['interface_theme']}",
            font=("Segoe UI", 13), text_color=theme["text"], anchor="w"
        ).pack(side="left")

        theme_values = [t["theme_system"], t["theme_dark"], t["theme_light"]]
        if self.pending_theme == "system":
            initial_theme_text = t["theme_system"]
        elif self.pending_theme == "dark":
            initial_theme_text = t["theme_dark"]
        else:
            initial_theme_text = t["theme_light"]

        self.theme_dropdown = ctk.CTkOptionMenu(
            theme_frame, values=theme_values,
            width=140, height=32, corner_radius=8,
            font=("Segoe UI", 12),
            fg_color=theme["btn_bg"], button_color=theme["btn_hover"],
