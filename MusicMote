    def _on_lang_select(self, choice: str):
        if "Систем" in choice or "System" in choice:
            self.pending_lang = "system"
        elif "Русский" in choice or "Russian" in choice:
            self.pending_lang = "ru"
        else:
            self.pending_lang = "en"

    def _on_theme_select(self, choice: str):
        if "Систем" in choice or "System" in choice:
            self.pending_theme = "system"
        elif "Тёмная" in choice or "Dark" in choice:
            self.pending_theme = "dark"
        else:
            self.pending_theme = "light"

    def _record_hotkey(self, key_id: str):
        btn = self.key_buttons[key_id]
        btn.configure(text="...", fg_color=self.theme["accent"], text_color="#000000")
        
        def _on_key():
            try:
                combo = keyboard.read_hotkey(suppress=False)
                if combo:
                    self.pending_hotkeys[key_id] = combo
            except Exception as exc:
                logger.error("Error reading hotkey: %s", exc)
            finally:
                self.after(0, lambda: self._build_ui())
        
        if HAS_KEYBOARD:
            threading.Thread(target=_on_key, daemon=True).start()
        else:
            val = fd.simpledialog.askstring("Hotkey", "Введите комбинацию клавиш (напр. ctrl+p):")
            if val:
                self.pending_hotkeys[key_id] = val
            self._build_ui()

    def _on_reset(self):
        self.pending_hotkeys = DEFAULT_HOTKEYS.copy()
        self.pending_lang = "system"
        self.pending_theme = "system"
        self._build_ui()

    def _on_save(self):
        new_config = {
            "hotkeys": self.pending_hotkeys,
            "language": self.pending_lang,
            "theme": self.pending_theme
        }
        self.on_save_cb(new_config)
        self.destroy()

# Dynamic DND Base Class
if HAS_DND:
    class BaseApp(ctk.CTk, TkinterDnD.DnDWrapper): pass
else:
    class BaseApp(ctk.CTk): pass

class App(BaseApp):
    def __init__(self):
        super().__init__()
        self.config = load_config()
        self.lang = self.config.get("language", "system")
        self.theme_mode = self.config.get("theme", "system")
        
        effective_lang = resolve_language(self.lang)
        effective_theme = resolve_theme(self.theme_mode)
        
        ctk.set_appearance_mode(effective_theme)
        ctk.set_default_color_theme("dark-blue")
        
        self.t = TRANSLATIONS[effective_lang]
        self.theme = THEMES[effective_theme]
        
        if HAS_DND:
            try:
                self.TkdndVersion = TkinterDnD._require(self)
                self.drop_target_register(DND_FILES)
                self.dnd_bind('<<Drop>>', self._on_drop_files)
            except Exception as e:
                logger.error("DND setup error: %s", e)

        self._service = MusicService(self.config)
        self._setup_window()
        self._build_ui()
        self._setup_hotkeys()
        self._setup_tray()

    def _setup_window(self):
        self.title(self.t["app_title"])
        self.geometry("320x550")
        self.resizable(False, False)
        self.configure(fg_color=self.theme["bg"])
        
        # Установка иконки окна
        try:
            icon_img = create_app_icon_image(64)
            if icon_img:
                ico_path = Path(__file__).parent / "musicmote_icon.ico"
                if not ico_path.exists():
                    icon_img.save(str(ico_path), format="ICO", sizes=[(16, 16), (32, 32), (48, 48), (64, 64)])
                self.iconbitmap(str(ico_path))
                from PIL import ImageTk
                self._tk_icon = ImageTk.PhotoImage(icon_img)
                self.iconphoto(False, self._tk_icon)
        except Exception as e:
            logger.debug("Window icon setup error: %s", e)

    def _build_ui(self):
        for widget in self.winfo_children():
            widget.destroy()

        t = self.t
        theme = self.theme

        # Header
        header = ctk.CTkFrame(self, fg_color="transparent")
        header.pack(fill="x", padx=20, pady=(18, 4))
        
        # Logo badge & typography
        icon_img = create_app_icon_image(40)
        if icon_img:
            self._ctk_logo = ctk.CTkImage(light_image=icon_img, dark_image=icon_img, size=(38, 38))
            ctk.CTkLabel(header, image=self._ctk_logo, text="").pack(side="left")
        else:
            logo_box = ctk.CTkFrame(header, width=38, height=38, corner_radius=10, fg_color=theme["accent"])
            logo_box.pack_propagate(False)
            logo_box.pack(side="left")
            ctk.CTkLabel(logo_box, text="M", font=("Segoe UI", 20, "bold"), text_color="#000000").pack(expand=True)
        
        title_box = ctk.CTkFrame(header, fg_color="transparent")
        title_box.pack(side="left", padx=(10, 0))
        ctk.CTkLabel(title_box, text="MusicMote", font=("Segoe UI", 20, "bold"), text_color=theme["text"]).pack(anchor="w")

        ctk.CTkFrame(self, height=1, fg_color=theme["surface2"]).pack(fill="x", padx=20, pady=(8, 14))

        # Main Action Buttons
        self._make_btn(text=t["open_app"], command=self._on_launch, accent=True).pack(pady=(0, 8))
        self._make_btn(text=t["choose_path"], command=self._on_choose_path).pack(pady=(0, 8))
        self._make_btn(text=t["open_settings"], command=self._on_open_settings).pack(pady=(0, 12))

        self._path_label = ctk.CTkLabel(self, text="", font=("Segoe UI", 10), text_color=theme["text_muted"])
        self._path_label.pack(pady=(0, 10))
        self._update_path_display()

        # Track Controls
        self._section_label(t["track_ctrl"])
        transport = ctk.CTkFrame(self, fg_color="transparent")
        transport.pack(pady=(4, 12))
        self._make_small_btn(transport, "⏮", self._on_prev).pack(side="left", padx=4)
        self._make_small_btn(transport, "⏯", self._on_play_pause, width=96).pack(side="left", padx=4)
        self._make_small_btn(transport, "⏭", self._on_next).pack(side="left", padx=4)

        # Volume Controls
        self._section_label(t["volume_ctrl"])
        volume = ctk.CTkFrame(self, fg_color="transparent")
        volume.pack(pady=(4, 12))
        self._make_small_btn(volume, "🔉", self._on_vol_down).pack(side="left", padx=4)
        self._make_small_btn(volume, "🔇", self._on_mute, width=54).pack(side="left", padx=4)
        self._make_small_btn(volume, "🔊", self._on_vol_up).pack(side="left", padx=4)

        ctk.CTkFrame(self, height=1, fg_color=theme["surface2"]).pack(fill="x", padx=20, pady=(4, 10))
        self._make_btn(text=t["show_player"], command=self._on_bring_to_front).pack()

        # Status Bar
        self._status_frame = ctk.CTkFrame(self, fg_color=theme["surface2"], corner_radius=8)
        self._status_frame.pack(fill="x", padx=20, pady=(12, 14))
        self._dot = ctk.CTkLabel(self._status_frame, text="●", font=("Segoe UI", 11), width=18, text_color=theme["text_muted"])
        self._dot.pack(side="left", padx=(10, 2), pady=6)
        self._status_label = ctk.CTkLabel(self._status_frame, text=t["ready"], font=("Segoe UI", 11), text_color=theme["text_muted"])
        self._status_label.pack(side="left", padx=(0, 10), pady=6)

    def _make_btn(self, text: str, command: Callable, accent: bool = False, width: int = 260) -> ctk.CTkButton:
        return ctk.CTkButton(
            self, text=text, command=command, width=width, height=self.theme["btn_height"],
            corner_radius=self.theme["radius"], font=("Segoe UI Semibold", 13),
            fg_color=self.theme["accent"] if accent else self.theme["surface2"],
            hover_color=self.theme["accent_hover"] if accent else "#2A2A2A",
            text_color="#0D0D0D" if accent else self.theme["text"], border_width=0
        )

    def _make_small_btn(self, master, text: str, command: Callable, width: int = 78) -> ctk.CTkButton:
        return ctk.CTkButton(
            master, text=text, command=command, width=width, height=self.theme["btn_height"],
            corner_radius=self.theme["radius"], font=("Segoe UI Semibold", 15),
            fg_color=self.theme["surface2"], hover_color="#2A2A2A",
            text_color=self.theme["text"], border_width=0
        )

    def _section_label(self, text: str):
        ctk.CTkLabel(self, text=text.upper(), font=("Segoe UI", 9), text_color=self.theme["text_muted"]).pack()

    def _update_path_display(self):
        path = self._service.app_path
        if path and path.exists():
            path_str = str(path)
            if len(path_str) > 36: path_str = path_str[:14] + "..." + path_str[-18:]
            self._path_label.configure(text=f"{self.t['using_prefix']}{path_str}")
        else:
            self._path_label.configure(text=self.t["drag_hint"])

    def _on_open_settings(self):
        HotkeysSettingsWindow(self, self.config, self._on_settings_saved)

    def _on_settings_saved(self, new_config: dict):
        self.config.update(new_config)
        save_config(self.config)
        
        self.lang = self.config.get("language", "system")
        self.theme_mode = self.config.get("theme", "system")
        
        effective_lang = resolve_language(self.lang)
        effective_theme = resolve_theme(self.theme_mode)
        
        self.t = TRANSLATIONS[effective_lang]
        self.theme = THEMES[effective_theme]
        
        ctk.set_appearance_mode(effective_theme)
        self.configure(fg_color=self.theme["bg"])
        self.title(self.t["app_title"])
        
        self._build_ui()
        self._setup_hotkeys()
        self._update_status_ui(self.t["saved_toast"], "ok")

    def _setup_hotkeys(self):
        if not HAS_KEYBOARD: return
        try:
            keyboard.unhook_all()
            hk = self.config.get("hotkeys", DEFAULT_HOTKEYS)
            if hk.get("play_pause"): keyboard.add_hotkey(hk["play_pause"], self._on_play_pause)
            if hk.get("next_track"): keyboard.add_hotkey(hk["next_track"], self._on_next)
            if hk.get("prev_track"): keyboard.add_hotkey(hk["prev_track"], self._on_prev)
            if hk.get("vol_up"): keyboard.add_hotkey(hk["vol_up"], self._on_vol_up)
            if hk.get("vol_down"): keyboard.add_hotkey(hk["vol_down"], self._on_vol_down)
            if hk.get("mute"): keyboard.add_hotkey(hk["mute"], self._on_mute)
        except Exception as e:
            logger.error("Hotkeys hook error: %s", e)

    def _setup_tray(self):
        if not HAS_TRAY: return
        self.protocol("WM_DELETE_WINDOW", self._hide_to_tray)

    def _hide_to_tray(self):
        self.withdraw()
        image = Image.new('RGB', (64, 64), color=(13, 13, 13))
        draw = ImageDraw.Draw(image)
        draw.ellipse((16, 16, 48, 48), fill=(255, 204, 0))
        menu = pystray.Menu(
            pystray.MenuItem("Развернуть / Restore", self._restore_from_tray),
            pystray.MenuItem("Выход / Exit", self._quit_app)
        )
        self.tray_icon = pystray.Icon("YaMusicCtrl", image, "YaMusic Controller", menu)
        threading.Thread(target=self.tray_icon.run, daemon=True).start()

    def _restore_from_tray(self, icon, item):
        icon.stop()
        self.after(0, self.deiconify)

    def _quit_app(self, icon, item):
        icon.stop()
        self.after(0, self.destroy)

    def _update_status_ui(self, message: str, kind: str):
        colors = {"info": self.theme["text_muted"], "ok": self.theme["success"], "error": self.theme["danger"]}
        self._dot.configure(text_color=colors.get(kind, self.theme["text_muted"]))
        self._status_label.configure(text=message, text_color=colors.get(kind, self.theme["text_muted"]))

    def _on_drop_files(self, event):
        files = self.tk.splitlist(event.data)
        if files: self._handle_new_path(Path(files[0]))

    def _handle_new_path(self, path_obj: Path):
        if path_obj.suffix.lower() == '.lnk':
            resolved = resolve_shortcut(path_obj)
            if resolved: path_obj = resolved
            else:
                self._update_status_ui(self.t["shortcut_err"][:25], "error")
                messagebox.showerror("Error", self.t["shortcut_err"])
                return
        if validate_path(path_obj):
            self.config["app_path"] = str(path_obj)
            save_config(self.config)
            self._service.app_path = path_obj
            self._update_path_display()
            self._update_status_ui(self.t["saved_path"], "ok")
        else:
            self._update_status_ui(self.t["not_yamusic"], "error")
            messagebox.showwarning("Warning", self.t["wrong_app_warn"])

    def _on_launch(self):
        self._update_status_ui(self.t["launching"], "info")
        def _cb(success: bool, msg_key: str):
            text = self.t.get(msg_key, msg_key)
            self._update_status_ui(text, "ok" if success else "error")
        self._service.launch(callback=_cb)

    def _on_choose_path(self):
        filepath = fd.askopenfilename(
            title=self.t["choose_path"],
            filetypes=[("Executables", "*.exe"), ("Shortcuts", "*.lnk"), ("All files", "*.*")]
        )
        if filepath: self._handle_new_path(Path(filepath))

    def _cmd(self, action: Callable[[], bool], label: str):
        if action(): self._update_status_ui(f"{label} ✓", "ok")
        else: self._update_status_ui("Яндекс Музыка не найдена", "error")

    def _on_play_pause(self): self._cmd(self._service.play_pause, "Play / Pause")
    def _on_next(self): self._cmd(self._service.next_track, self.t["next_track"])
    def _on_prev(self): self._cmd(self._service.prev_track, self.t["prev_track"])
    def _on_vol_up(self): self._cmd(self._service.volume_up, self.t["vol_up"])
    def _on_vol_down(self): self._cmd(self._service.volume_down, self.t["vol_down"])
    def _on_mute(self): self._cmd(self._service.volume_mute, self.t["mute"])
    def _on_bring_to_front(self):
        if self._service.bring_to_front(): self._update_status_ui("Окно открыто", "ok")
        else: self._update_status_ui("Яндекс Музыка не найдена", "error")

if __name__ == "__main__":
    app = App()
    app.mainloop()
